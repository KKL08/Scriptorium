#!/usr/bin/env bash
set -euo pipefail
# 向上找 pyproject.toml 定位项目根（skill 文件夹，scripts 的上一层）
# 经 ~/.local/bin 等软链调用时先解析到真实脚本位置；逐级 readlink，不依赖老版 macOS 不支持的 readlink -f
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
while [ ! -f "$ROOT/pyproject.toml" ] && [ "$ROOT" != "/" ]; do
  ROOT="$(dirname "$ROOT")"
done
if [ ! -f "$ROOT/pyproject.toml" ]; then
  echo "violet-refine: 找不到项目根（pyproject.toml）" >&2
  exit 1
fi
exec uv run --project "$ROOT" violet-refine "$@"
